---
const year = new Date().getFullYear();
---

<footer class="border-t">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-4 md:flex-row">
    <p class="text-sm text-muted-foreground">
      © {year} Joseph Osei Yaw Nyarko. All rights reserved.
    </p>
    <div class="flex items-center gap-3 font-display">
      <a
        aria-label="Email"
        href="mailto:jnyarko342@gmail.com"
        class="text-muted-foreground hover:text-foreground transition-colors"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m22 7-8.5 5.7a2 2 0 0 1-2.2 0L2 7" />
          <rect width="20" height="16" x="2" y="4" rx="2" />
        </svg>
      </a>
      <a
        aria-label="GitHub"
        href="https://github.com/joe342wise"
        target="_blank"
        rel="noreferrer"
        class="text-muted-foreground hover:text-foreground transition-colors"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
      </a>
      <a
        aria-label="LinkedIn"
        href="https://linkedin.com/in/joseph-nyarko-4678b8265"
        target="_blank"
        rel="noreferrer"
        class="text-muted-foreground hover:text-foreground transition-colors"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect width="4" height="12" x="2" y="9" />
          <circle cx="4" cy="4" r="2" />
        </svg>
      </a>
    </div>
  </div>
</footer>
