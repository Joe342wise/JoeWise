---
interface ProjectData {
  id: string;
  title: string;
  shortDescription: string;
  fullDescription: string;
  techs: string[];
  github?: string;
  live?: string;
  status: "completed" | "in-progress" | "concept";
}

const projectsData: ProjectData[] = [
  {
    id: "auth-system",
    title: "Auth-System",
    shortDescription:
      "Secure authentication system with email/password, Google OAuth, OTP-based MFA, and JWT session management.",
    fullDescription:
      "A secure authentication system built with Node.js, Express, MongoDB, and Passport.js. It supports traditional email and password authentication, Google OAuth, and OTP-based multi-factor authentication. JWT is used for session management, and token blacklisting is included to make logout and session invalidation safer.",
    techs: ["Node.js", "Express", "MongoDB"],
    github: "https://github.com/Joe342wise/auth-system.git",
    status: "completed",
  },
  {
    id: "mentorship-app",
    title: "Mentorship App",
    shortDescription:
      "Mentorship platform for mentor discovery, session booking, progress tracking, and platform administration.",
    fullDescription:
      "The KNUST Mentorship Platform enables mentees to discover mentors, set goals, book sessions, and track progress. Mentors can share expertise and guide growth, while admins manage users, moderate content, and view platform analytics. The backend is built around Hono, TypeScript, PostgreSQL, and Better Auth.",
    techs: ["Hono", "TypeScript", "PostgreSQL", "Better Auth"],
    github:
      "https://github.com/Orctatech-Engineering-Team/mentorship-app-backend.git",
    live: "https://mentorship.orctatech.com/reference",
    status: "completed",
  },
  {
    id: "gamestore-api",
    title: "GameStore API",
    shortDescription:
      "Minimal ASP.NET Core API for managing games and genres with EF Core and SQLite.",
    fullDescription:
      "A minimal ASP.NET Core 9 Web API for managing games and genres using Entity Framework Core with SQLite. It demonstrates Minimal APIs, DTO-based mapping, EF Core migrations, and simple seed data for genres.",
    techs: [".NET", "ASP.NET Core Minimal APIs", "EF Core 9", "SQLite"],
    github: "https://github.com/Joe342wise/ASP.NET_Core.git",
    status: "completed",
  },
];

const inProgressCount = projectsData.filter(
  (project) => project.status === "in-progress",
).length;
const completedCount = projectsData.filter(
  (project) => project.status === "completed",
).length;
---

<div class="max-w-4xl mx-auto">
  <div class="space-y-3">
    <div class="flex items-center justify-between px-1 mb-6">
      <div>
        <h3 class="text-lg font-semibold text-foreground">Projects</h3>
        <p class="text-sm text-muted-foreground">
          {projectsData.length} projects · {inProgressCount} in progress
        </p>
      </div>
      <a
        href="https://github.com/joe342wise?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span class="hidden sm:inline">View all on GitHub</span>
        <svg
          viewBox="0 0 24 24"
          class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
      </a>
    </div>

    {projectsData.map((project) => (
      <details class="project-card group border rounded-md transition-colors duration-200 overflow-hidden">
        <summary class="w-full list-none p-3 sm:p-4 flex items-center justify-between gap-3 sm:gap-4 text-left cursor-pointer">
          <div class="w-28 sm:w-36 shrink-0">
            <span class="text-sm font-medium truncate text-foreground">
              {project.title}
            </span>
          </div>

          <div class="flex-1 min-w-0 hidden sm:block">
            <p class="text-sm text-muted-foreground truncate">
              {project.shortDescription}
            </p>
          </div>

          <svg
            viewBox="0 0 24 24"
            class="project-arrow w-4 h-4 text-muted-foreground shrink-0 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </summary>

        <div class="project-panel grid transition-all duration-300 ease-out">
          <div class="overflow-hidden">
            <div class="px-4 pb-4 pt-0 border-t border-border/50 mt-0">
              <div class="pt-4 space-y-4">
                <p class="text-sm text-muted-foreground sm:hidden">
                  {project.shortDescription}
                </p>

                <p class="text-sm text-foreground/80 leading-relaxed">
                  {project.fullDescription}
                </p>

                <div class="flex flex-wrap gap-1.5">
                  {project.techs.map((tech) => (
                    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80 text-xs font-normal">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-3 pt-1">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors group/link"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                        <path d="M9 18c-4.51 2-5-2-7-2"></path>
                      </svg>
                      <span>Source</span>
                      <svg
                        viewBox="0 0 24 24"
                        class="w-3 h-3 opacity-0 -translate-x-1 group-hover/link:opacity-100 group-hover/link:translate-x-0 transition-all"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M15 3h6v6"></path>
                        <path d="M10 14 21 3"></path>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      </svg>
                    </a>
                  )}
                  {project.live && (
                    <a
                      href={project.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-primary hover:text-primary/80 transition-colors group/link"
                    >
                      <span>Live Demo</span>
                      <svg
                        viewBox="0 0 24 24"
                        class="w-3 h-3 transition-transform group-hover/link:translate-x-0.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M15 3h6v6"></path>
                        <path d="M10 14 21 3"></path>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </details>
    ))}

    <div class="flex items-center justify-between px-1 pt-4 border-t border-border/30 mt-4">
      <p class="text-xs text-muted-foreground">
        {completedCount} completed · {inProgressCount} in progress
      </p>
    </div>
  </div>
</div>

<style>
  .project-card > summary::-webkit-details-marker {
    display: none;
  }

  .project-card > .project-panel {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .project-card[open] > .project-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .project-card[open] .project-arrow {
    transform: rotate(90deg);
  }

  @media (hover: hover) {
    .project-card:not([open]):hover .project-arrow {
      transform: translateX(2px);
    }
  }
</style>
